{
  "name": "@askvero/agent-connect",
  "version": "0.1.0",
  "description": "Connect AI agents to a user's Vero financial data through the public Vero Agent Access API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/tszaks/vero-agent-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tszaks/vero-agent-connect.git"
  },
  "bugs": {
    "url": "https://github.com/tszaks/vero-agent-connect/issues"
  },
  "bin": {
    "vero-api": "dist/cli.js",
    "vero-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "openapi.json",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:mcp": "tsx src/mcp-server.ts",
    "dev:cli": "tsx src/cli.ts"
  },
  "keywords": [
    "vero",
    "askvero",
    "finance",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "personal-finance",
    "openapi"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
